# Copy this file to .env and fill in real values to connect a live Supabase project.
# Until these are set, the app runs in demo mode against in-memory mock data
# (see src/config/env.ts -> isSupabaseConfigured).

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# URL of the local Baileys WhatsApp server (see /server). Defaults to
# http://localhost:4000 when unset — run `npm run dev` inside /server first.
VITE_WHATSAPP_SERVER_URL=http://localhost:4000
# Must match WHATSAPP_SERVER_TOKEN in server/.env — every request to the
# WhatsApp server requires this bearer token.
VITE_WHATSAPP_SERVER_TOKEN=
